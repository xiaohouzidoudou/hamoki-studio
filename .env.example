# Hamoki Studio v0.6.3 账号版示例配置
# 绝对不要提交 .env
COOKIE_SECURE=1
HOST_PORT=8030
MAX_CONCURRENT=1

# 请替换成自己的独立 HTTPS 域名
APP_ALLOWED_HOST=studio.example.com
APP_BASE_PATH=

# 至少 32 位随机字符（全站主密钥）
APP_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# 注册邀请码，必须自行设定强随机值，切勿使用示例值
INVITE_CODE=REPLACE_WITH_PRIVATE_RANDOM_INVITE

# 存储额度：每账号 1GB，总量 5GB（前期最多 5 人）
USER_QUOTA_GB=1
TOTAL_QUOTA_GB=5
